generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PageBlockType {
  HERO
  RICH_TEXT
  COUNTDOWN
  SCHEDULE
  AWARDS
  NEWS
  PARTNERS
  VIDEO
  GALLERY
  CTA
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          UserRole       @default(USER)
  posts         Post[]
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  blocks         Json
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug, status])
}

model Post {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  thumbnail      String?
  coverImage     String?
  content        Json?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  blocks         Json
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  media          Media[]
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug, status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("posts")
}

model Schedule {
  id          String   @id @default(cuid())
  date        DateTime
  time        String
  title       String
  description String
  order       Int      @default(0)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, order])
  @@map("schedules")
}

model Award {
  id          String   @id @default(cuid())
  title       String
  description String
  prize       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("awards")
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  website     String?
  logoUrl     String?
  tier        String   @default("Partner")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  media       Media[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tier, order])
  @@map("partners")
}

model Media {
  id          String     @id @default(cuid())
  title       String
  url         String
  type        MediaType  @default(IMAGE)
  altText     String?
  postId      String?
  post        Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  partnerId   String?
  partner     Partner?   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pageBlocks  PageBlock[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
  @@index([postId])
  @@index([partnerId])
  @@map("media")
}

model Registration {
  id          String             @id @default(cuid())
  fullName    String
  email       String
  phone       String
  address     String
  imageUrl    String?
  description String?
  status      RegistrationStatus @default(PENDING)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@map("registrations")
}

model PageBlock {
  id        String        @id @default(cuid())
  pageKey   String
  type      PageBlockType
  title     String?
  content   Json
  order     Int           @default(0)
  isActive  Boolean       @default(true)
  mediaId   String?
  media     Media?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([pageKey, order])
  @@index([type])
  @@index([mediaId])
  @@map("page_blocks")
}

model Application {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  city        String
  portfolio   String?
  message     String?
  consent     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
